<?xml version="1.0" encoding="utf-8"?>
<!-- 备份/迁移的提取规则（API 31+）：一律排除，配合 android:allowBackup="false"，
     确保 adb backup / 云备份 / 设备迁移都不会带走应用私有数据（含 WebView 本地存储与书库）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
